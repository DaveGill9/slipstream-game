{
  "name": "slipstream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-multiplayer.mjs",
    "test": "node --import tsx --test src/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:lan": "node scripts/serve.mjs --lan",
    "check": "npm test && npm run build",
    "multiplayer": "node server-dist/server.mjs"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "phaser": "^3.90.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
