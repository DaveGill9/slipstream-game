{
  "name": "slipstream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test src/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:lan": "node scripts/serve.mjs --lan",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "@types/matter-js": "^0.20.2",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
