{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "slipstream-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "slipstream-online",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "import('./server-dist/server.mjs').then((m) => m.startServer({ port: 8137 }))"
      ],
      "port": 8137
    }
  ]
}
